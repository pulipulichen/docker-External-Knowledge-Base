[api]
# API_KEY: API key for external services
API_KEY="YOUR_API_KEY"

# USE_MOCK_DB: Set to true to use a mock database, false otherwise
USE_MOCK_DB=false

# For download link
URL_HOST=http://localhost:8080/f/

[provider]

GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-flash-latest"

[scrape]
# Mercury Parser (used by POST /scrape): base URL of mercury-parser-api inside Docker network
MERCURY_PARSER_URL=http://mercury-parser:3000
# Request timeout in seconds when calling Mercury Parser
MERCURY_REQUEST_TIMEOUT=90

[search]
SEARCH_MAX_RESULT_LIMIT=5
NEWS_MAX_RESULT_LIMIT=5

[searxng]
# Markdown converter (ingest): POST file_path for MarkItDown; must match converter container mount
MARKDOWN_CONVERTER_URL=http://markdown_converter:80
MARKDOWN_CONVERTER_TIMEOUT=125

# SearXNG (used by POST /search): base URL inside Docker network
SEARXNG_URL=http://searxng:8080
# Request timeout in seconds when calling SearXNG
SEARXNG_REQUEST_TIMEOUT=30

# SearXNG 容器：對應官方 SEARXNG_SECRET（覆寫密鑰）。未設定時 docker-compose 使用預設字串（僅本機測試）。
# SEARXNG_SECRET=
SEARXNG_SECRET=ultrasecretkey2ultrasecretkey

[redis]
# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_EXPIRATION_SECONDS=2592000

[weaviate]
WEAVIATE_HOST=weaviate
WEAVIATE_PORT=8080
WEAVIATE_URL=http://weaviate:8080

WEAVIATE_GRPC_PORT=50051

[markdown]

IMAGE_DESCRIPTION_ENABLED=true
IMAGE_DESCRIBE_MIN_EDGE_PX=128

[embedding]
# Embedding engine: ollama (default, local) or gemini (remote API)
EMBEDDING_ENGINE=ollama

# Embeddings REST 專用；預設為 Google 官方。勿沿用 [api] 的 GEMINI_BASE_URL 除非該 URL 亦提供 v1beta embedContent。
# GEMINI_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# 可選；留空則使用模型預設維度。gemini-embedding-001 / 2 支援 768、1536、3072 等
GEMINI_EMBEDDING_OUTPUT_DIMENSIONALITY=3072
# 僅 gemini-embedding-001 有效：RETRIEVAL_QUERY / RETRIEVAL_DOCUMENT 等（見官方文件）
GEMINI_EMBEDDING_TASK_TYPE_QUERY=RETRIEVAL_QUERY
GEMINI_EMBEDDING_TASK_TYPE_DOCUMENT=RETRIEVAL_DOCUMENT

[ollama]
# Local Ollama embedding service. BGE-M3 outputs 1024-dimensional embeddings.
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# Ollama unloads the model after this idle period, reducing idle RAM usage.
OLLAMA_KEEP_ALIVE=5m
SERVICE_CHECK_INTERVAL=5
SERVICE_CHECK_TIMEOUT=60
